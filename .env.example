# API
PORT=4000
JWT_SECRET=change-me-in-production
DATABASE_PATH=./data/findatagraph.db
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
POLICY_VERSION=jumpstart-v1
# Set to 1 inside client tenancy (sandbox fixture or live Salesforce)
CONNECTOR_LIVE=
SF_MODE=sandbox
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=
# SF_INVOICE_SOQL=

# LangGraph orchestrator sidecar (optional — falls back to in-process graph)
ORCHESTRATOR_URL=
CONTROL_PLANE_URL=http://127.0.0.1:4000
ORCHESTRATOR_PORT=8100

# Web (Vite)
VITE_API_URL=http://localhost:4000/api/v1
