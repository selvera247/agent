# API
PORT=4000
JWT_SECRET=change-me-in-production
DATABASE_PATH=./data/findatagraph.db
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
POLICY_VERSION=jumpstart-v1

# Auth — preferred: okta | clerk ; local = Jumpstart demo
AUTH_MODE=local
AUTH_ALLOW_LOCAL=1
AUTH_DEFAULT_ORG_ID=org_fdg_demo
AUTH_DEFAULT_ROLE=accountant
AUTH_ROLE_CLAIM=role
AUTH_GROUP_ADMIN=findatagraph-admin
AUTH_GROUP_CONTROLLER=findatagraph-controller
AUTH_GROUP_ACCOUNTANT=findatagraph-accountant
# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API=
# CLERK_JWT_ISSUER=
# CLERK_JWKS_URI=
# CLERK_JWT_AUDIENCE=
# Okta
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_AUDIENCE=
OKTA_REDIRECT_URI=
PUBLIC_APP_URL=http://localhost:5173

# Set to 1 inside client tenancy (sandbox fixture or live Snowflake)
CONNECTOR_LIVE=
SNOWFLAKE_MODE=sandbox
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
# SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_INVOICE_SQL=
# SNOWFLAKE_GL_SQL=
# SNOWFLAKE_TOKEN=

# Optional live multi-platform Sources (mode=live on source_connections)
# POSTGRES_URL=postgres://user:pass@host:5432/db
# MYSQL_URL=mysql://user:pass@host:3306/db
# DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
# DATABRICKS_TOKEN=
# DATABRICKS_WAREHOUSE_ID=

# LangGraph orchestrator sidecar (optional — falls back to in-process graph)
ORCHESTRATOR_URL=
CONTROL_PLANE_URL=http://127.0.0.1:4000
ORCHESTRATOR_PORT=8100

# Web (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_CLERK_PUBLISHABLE_KEY=
